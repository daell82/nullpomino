<?xml version="1.0" encoding="UTF-8"?>
<launch4jConfig>
  <dontWrapJar>true</dontWrapJar>
  <headerType>gui</headerType>
  <jar>lib\nullpomino-slick.jar</jar>
  <outfile>..\scripts\NullpoMino.exe</outfile>
  <errTitle></errTitle>
  <cmdLine></cmdLine>
  <chdir>.</chdir>
  <priority>normal</priority>
  <downloadUrl>https://adoptium.net/temurin/releases</downloadUrl>
  <supportUrl></supportUrl>
  <stayAlive>true</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <manifest></manifest>
  <icon>..\res\icons\nullpomino-virulent.ico</icon>
  <classPath>
    <mainClass>mu.nu.nullpo.gui.slick.NullpoMinoSlick</mainClass>
    <cp>lib\*</cp>
  </classPath>
  <jre>
    <path>%JAVA_HOME%;%PATH%</path>
    <requiresJdk>false</requiresJdk>
    <requires64Bit>true</requires64Bit>
    <minVersion>25</minVersion>
    <maxVersion></maxVersion>
    <opt>-Djava.library.path=lib</opt>
  </jre>
</launch4jConfig>